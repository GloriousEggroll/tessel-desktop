[Unit]
Description=Saved passwords (waykeyring, org.freedesktop.secrets)
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5
OnFailure=desktop-suite-failed@%n.service

[Service]
Type=dbus
BusName=org.freedesktop.secrets
EnvironmentFile=-%h/.config/labwc/environment
ExecStart=/usr/local/lib/desktop-suite/keyring/waykeyring
Restart=on-failure
RestartSec=1
