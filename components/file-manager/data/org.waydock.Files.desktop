[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=Browse files, devices, and network locations
Exec=wayfiles %U
Icon=system-file-manager
Terminal=false
StartupNotify=true
StartupWMClass=org.waydock.Files
MimeType=inode/directory;
Categories=System;FileTools;FileManager;
Keywords=Files;Folders;Explorer;Network;Trash;
Actions=NewWindow;Home;

[Desktop Action NewWindow]
Name=New Window
Exec=wayfiles --new-window

[Desktop Action Home]
Name=Home Folder
Exec=wayfiles --home
