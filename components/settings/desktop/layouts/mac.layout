{
  "version": 1,
  "name": "Mac",
  "dock": {
    "alignment": "center",
    "always_show_tray": [
      "id:dnf-app-center-updater",
      "id:steam"
    ],
    "always_visible_apps": [
      "idle_inhibitor",
      "capslock",
      "bluetooth",
      "audio",
      "showdesktop"
    ],
    "app_dock_auto_hide": false,
    "app_dock_background_color": "#38373a",
    "app_dock_edge": "bottom",
    "app_dock_expand": false,
    "app_dock_float_mode": true,
    "app_dock_frost_strength": 60,
    "app_dock_frosted": true,
    "app_dock_gap": 8,
    "app_dock_group_layout": {
      "start": [],
      "center": [
        "app_menu",
        "pinned",
        "running",
        "files"
      ],
      "end": []
    },
    "app_dock_icon_size": 48,
    "app_dock_match_wallpaper": true,
    "app_dock_rounded_corners": true,
    "app_dock_shine": true,
    "app_dock_shadow": true,
    "app_dock_transparency": 35,
    "app_dock_transparency_enabled": true,
    "application_display": "icons",
    "apps_frost_strength": 50,
    "apps_frosted": true,
    "apps_rounded_corners": true,
    "apps_transparency": 10,
    "apps_transparency_enabled": true,
    "auto_hide": false,
    "background_color": null,
    "bar_border_color": "#777777",
    "bar_border_enabled": false,
    "bar_border_sides": [],
    "bar_float_mode": false,
    "bar_rounded_corners": true,
    "colored_window_buttons": true,
    "compact_bar": true,
    "edge": "top",
    "float_mode": true,
    "frost_strength": 50,
    "frosted": true,
    "gap": 0,
    "group_layouts": {
      "bar": {
        "start": [
          "session",
          "focused_title"
        ],
        "center": [
          "app_menu",
          "pinned",
          "running",
          "files"
        ],
        "end": [
          "activities",
          "media",
          "system_tray",
          "service_apps",
          "clock",
          "weather",
          "workspaces"
        ]
      }
    },
    "group_visibility": {
      "app_menu": true,
      "pinned": true,
      "running": true,
      "files": true,
      "workspaces": false,
      "media": true,
      "system_tray": true,
      "service_apps": true,
      "weather": false,
      "clock": true,
      "session": true,
      "activities": false,
      "focused_title": true
    },
    "hide_delay_ms": 500,
    "hide_on_fullscreen": false,
    "hot_corner_delay_ms": 150,
    "hot_corners": {},
    "hover_scale": 1.6,
    "icon_size": 24,
    "magnification": true,
    "match_wallpaper": true,
    "menu_hotkey_fullscreen": false,
    "mode": "bar",
    "monitor": "all",
    "monitor_overrides": {},
    "reveal_delay_ms": 120,
    "rounded_corners": true,
    "separate_app_dock": true,
    "transparency": 35,
    "transparency_enabled": true,
    "window_buttons_left": true
  },
  "workspaces": 4,
  "gapless": true,
  "clock": {
    "stacked": false,
    "date_first": true,
    "use_24_hour": false,
    "date_order": "mdy",
    "date_separator": "/",
    "show_date": true,
    "show_year": false,
    "show_weekday": true,
    "month_name": true,
    "short_names": true
  }
}
