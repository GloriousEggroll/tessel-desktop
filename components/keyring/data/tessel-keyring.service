[Unit]
Description=Saved passwords (tessel-keyring, org.freedesktop.secrets)
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5
OnFailure=tessel-failed@%n.service

[Service]
Type=dbus
BusName=org.freedesktop.secrets
EnvironmentFile=-%h/.config/labwc/environment
ExecStart=/usr/local/lib/tessel/keyring/tessel-keyring
Restart=on-failure
RestartSec=1
