[Unit]
Description=Tessel Shell secure screen lock
After=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=-%h/.config/labwc/environment
ExecStart=%h/.local/share/tessel-lock/tessel-lock
Restart=on-failure
RestartSec=1
SuccessExitStatus=75
TimeoutStartSec=30s
LimitCORE=0
