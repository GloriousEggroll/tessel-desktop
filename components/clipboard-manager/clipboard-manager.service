[Unit]
Description=Clipboard: keep copied content after its application closes
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5
OnFailure=desktop-suite-failed@%n.service

[Service]
Type=simple
EnvironmentFile=-%h/.config/labwc/environment
ExecStart=%h/.config/waybar/scripts/clipboard-manager/wayclip
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
