[Unit]
Description=Wayshell secure screen lock
After=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=-%h/.config/labwc/environment
ExecStart=%h/.local/share/lock-screen/lock-screen
Restart=on-failure
RestartSec=1
SuccessExitStatus=75
TimeoutStartSec=30s
LimitCORE=0
