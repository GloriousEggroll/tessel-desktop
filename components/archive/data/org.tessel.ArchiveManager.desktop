[Desktop Entry]
Type=Application
Name=Archive Manager
GenericName=Archiving Tool
Comment=Create, open, extract and edit archives
Exec=tessel-archive %U
Icon=package-x-generic
Terminal=false
StartupNotify=true
StartupWMClass=org.tessel.ArchiveManager
MimeType=application/x-tar;application/x-cbt;application/x-compressed-tar;application/x-bzip2-compressed-tar;application/x-bzip-compressed-tar;application/x-xz-compressed-tar;application/x-lzma-compressed-tar;application/x-zstd-compressed-tar;application/x-lzip-compressed-tar;application/x-tzo;application/x-lz4-compressed-tar;application/x-lrzip-compressed-tar;application/x-tarz;application/zip;application/x-zip-compressed;application/vnd.comicbook+zip;application/x-cbz;application/x-java-archive;application/x-7z-compressed;application/x-cb7;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/vnd.comicbook-rar;application/x-cbr;application/gzip;application/x-gzip;application/x-bzip2;application/x-bzip;application/x-xz;application/x-lzma;application/zstd;application/x-zstd;application/x-lzip;application/x-lzop;application/x-lz4;application/x-lrzip;application/x-compress;application/x-cd-image;application/x-iso9660-image;application/x-cpio;application/x-sv4cpio;application/x-sv4crc;application/x-bcpio;application/vnd.debian.binary-package;application/x-deb;application/x-rpm;application/x-source-rpm;application/x-redhat-package-manager;application/x-archive;application/x-xar;application/vnd.ms-cab-compressed;application/x-lha;application/x-lzh-compressed;application/x-arj;application/vnd.squashfs;application/vnd.appimage;application/x-iso9660-appimage;application/x-ms-wim;
Categories=Utility;Archiving;Compression;GTK;
Keywords=archive;zip;tar;7z;rar;compress;extract;unpack;pack;Ark;
