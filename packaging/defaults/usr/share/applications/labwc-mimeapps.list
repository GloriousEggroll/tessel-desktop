# Desktop suite defaults for the labwc session (XDG_CURRENT_DESKTOP=wlroots:labwc).
# Archive Manager (org.waydock.ArchiveManager) opens every archive type it supports;
# the list is the MimeType= line of components/archive-manager/data/org.waydock.ArchiveManager.desktop.
# ~/.config/mimeapps.list (Global Settings > Default Apps) overrides these per user.
[Default Applications]
application/x-tar=org.waydock.ArchiveManager.desktop;
application/x-cbt=org.waydock.ArchiveManager.desktop;
application/x-compressed-tar=org.waydock.ArchiveManager.desktop;
