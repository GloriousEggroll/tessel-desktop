== Python call sites mapped ==
lock_screen.py: Wallpaper(conn, executor, self.refresh) -> Wallpaper::new(conn, move || refresh());
  LoginLayer(bg, content, settled=f) -> LoginLayer::new(&bg, &content, f); background.configure(config, blur);
  background.tint = t; background.redraw() -> set_tint(t); redraw(); weather.update(owner.weather, a, b) -> update(&weather, a, b);
  WallpaperDashboard(clock, date, weather, media_row, assistant, status) -> new(..., Some(status.upcast_ref()));
  LockWeather(cb) -> LockWeather::new(cb, None, None); LockMedia(cb, readonly=preview) -> LockMedia::new(cb, preview); MediaIcons(cb) -> MediaIcons::default()
login_ui.py: Wallpaper(conn, executor, palette_changed); LoginLayer(bg, content, settled=...); Avatar(); submit_icon(); preview_close_button(app.quit);
  family_css('waylogin'); long_date(now); background.palette_color -> palette_color()
luna_clock.py: Wallpaper(monitor, executor) -> Wallpaper::new("", ||{}); VoiceBand(); VoiceLog(path); AlbumArt(cb) -> AlbumArt::new(cb, None)
