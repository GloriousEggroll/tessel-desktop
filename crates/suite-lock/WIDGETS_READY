Avatar (Clone, Rc):  Avatar::new() | Avatar::with_icons_dir(&Path)  (tests)
   .widget()->&gtk::Box (class family-avatar)  .set_user(name:&str, username:Option<&str>)
   .text()  .child()->Option<gtk::Widget> (Picture|Label|Image)  .pixel_size()
Wallpaper (gtk::Widget subclass; use as widget directly, e.g. Overlay child):
   Wallpaper::new(monitor_connector:&str, changed: impl Fn()+'static)   # Python Wallpaper(conn, executor, changed); decode on gio::spawn_blocking
   .set_changed(f)  .configure(&LockConfig, blur:i64)  .refresh()  .redraw()
   .tint()/.set_tint((r,g,b,a))   # Python `background.tint = ...; background.redraw()`
   .palette_color()->(u8,u8,u8)   .current_path()->Option<PathBuf>   .set_next_rotation(0.0) then .refresh()  (--next-wallpaper)
   .surface()/.blurred()/.previous()->Option<gdk::Texture>   .prepare_count()->u32 (decode jobs started; tests)
   .snapshot_background(&gtk::Snapshot, w, h, blurred:bool)   .fade_mix(now_us)  .is_animating()  .close()  .is_closed()
   Closes itself on unrealize (like Python).
LoginLayer (gtk::Widget subclass):
   LoginLayer::new(&Wallpaper, &content_widget, settled: impl Fn(bool)+'static)   # creates the LoginBackdrop, sets wallpaper overlay
   .reveal(visible:bool, animate:bool)   # Python reveal(v) == reveal(v, true); reveal(v, animate=False) == reveal(v,false)
   .progress() .target() .set_progress(p) (tests: layer.progress=.5 + queue_allocate)
   .frame_at(now_us)->glib::ControlFlow  .cancel_animation()  (test_frame_clock: reveal(true); cancel_animation(); frame_at(t)...)
   .is_animating() .content() .backdrop() .close()
   Pure model: visuals::Slide {progress,start,target,started} .retarget(t) .step(now_us)->finished
VoiceBand (Clone, Rc):  VoiceBand::new()  .widget()->&gtk::DrawingArea  .update(state:&str)  .close()
   .state() .display_state() .alpha() .is_animating()
Helpers: prepare_wallpaper(path,w,h,placement,radius,color)->Result<Prepared,String>, gaussian_blur, Rgb, parse_color("#rrggbb").

