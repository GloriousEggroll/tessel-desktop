[Unit]
Description=Tessel clipboard: keep copied content after its application closes
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5
OnFailure=tessel-failed@%n.service

[Service]
Type=simple
EnvironmentFile=-%h/.config/labwc/environment
EnvironmentFile=-%h/.config/labwc/environment.d/90-local.env
ExecStart=%h/.local/lib/tessel/tessel-clipboard
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
