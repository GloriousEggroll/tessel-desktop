[Unit]
Description=Tessel authentication agent (polkit)
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5
OnFailure=tessel-failed@%n.service

[Service]
Type=notify
TimeoutStartSec=15
EnvironmentFile=-%h/.config/labwc/environment
EnvironmentFile=-%h/.config/labwc/environment.d/90-local.env
ExecStart=%h/.local/lib/tessel/tessel-auth
Restart=on-failure
RestartSec=1
