[Unit]
Description=Tessel Dock: application dock, panel and system tray
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5
OnFailure=tessel-failed@%n.service

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=30
Environment=GDK_BACKEND=wayland
EnvironmentFile=-%h/.config/labwc/environment
EnvironmentFile=-%h/.config/labwc/environment.d/90-local.env
ExecStart=%h/.local/lib/tessel/tessel-dock
Restart=on-failure
RestartSec=1
