[Unit]
Description=Tessel Dock: application dock, panel and system tray
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5
OnFailure=tessel-failed@%n.service

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=30
Environment=GDK_BACKEND=wayland
EnvironmentFile=-%h/.config/labwc/environment
EnvironmentFile=-%h/.config/labwc/environment.d/90-local.env
ExecStart=%h/.local/lib/tessel/tessel-dock
# The dock comes back after any exit that systemd or `tessel-dock --quit`
# (exit status 75) did not ask for. A signal from elsewhere ends it with a
# clean exit, which Restart=on-failure left without a dock until the next login.
Restart=always
SuccessExitStatus=75
RestartPreventExitStatus=75
RestartSec=1
