[Unit]
Description=Tessel automatic touch keyboard
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5
OnFailure=tessel-failed@%n.service

[Service]
Type=simple
Environment=GDK_BACKEND=wayland
LimitCORE=0
EnvironmentFile=-%h/.config/labwc/environment
EnvironmentFile=-%h/.config/labwc/environment.d/90-local.env
ExecStart=%h/.local/lib/tessel/tessel-keyboard --background
Restart=on-failure
RestartSec=1
