[Unit]
Description=Tessel display layout: applies monitor settings and follows hotplug
After=graphical-session.target
PartOf=graphical-session.target
Conflicts=way-displays.service
StartLimitIntervalSec=60
StartLimitBurst=5
OnFailure=tessel-failed@%n.service

[Service]
Type=simple
EnvironmentFile=-%h/.config/labwc/environment
EnvironmentFile=-%h/.config/labwc/environment.d/90-local.env
ExecStart=%h/.local/lib/tessel/tessel-displays --daemon
Restart=on-failure
RestartSec=1
