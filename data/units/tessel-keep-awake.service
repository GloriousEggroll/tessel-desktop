[Unit]
Description=Tessel Keep Awake idle inhibitor
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5
OnFailure=tessel-failed@%n.service

[Service]
Type=simple
EnvironmentFile=-%h/.config/labwc/environment
EnvironmentFile=-%h/.config/labwc/environment.d/90-local.env
ExecStart=%h/.local/lib/tessel/tessel-keep-awake --background
Restart=on-failure
RestartSec=1
