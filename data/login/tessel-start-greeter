#!/bin/sh
# The Tessel login screen (greetd's greeter command, /etc/greetd/tessel-config.toml).
# No user desktop autostart, portals, terminal shortcuts, or X11 fallback.
unset DISPLAY WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS
export GDK_BACKEND=wayland
export GTK_USE_PORTAL=0
export GIO_USE_VFS=local
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=TesselLogin
export XDG_CONFIG_HOME=/etc/tessel/login
export XDG_CONFIG_DIRS=/etc/tessel/login
# Accessibility stays enabled: dbus-run-session gives the greeter its own
# session bus, where org.a11y.Bus (at-spi-bus-launcher) is D-Bus activated on
# demand for GTK and the greeter's screen reader. Without at-spi2-core, silence
# GTK's warnings about the missing accessibility bus.
if [ ! -x /usr/libexec/at-spi-bus-launcher ] && [ ! -x /usr/lib/at-spi-bus-launcher ]; then
    export GTK_A11Y=none
fi
umask 077
# Keep what the compositor and the greeter say in the journal (identifier
# tessel-login-greeter). greetd gives them the console, where a login screen
# that never appears leaves nothing to read afterwards. In the journal the
# compositor is verbose (-V): which screens and GPU it found and when its
# console was taken away are what explain a login screen that is not shown.
verbose=
journal=
if [ -z "${TESSEL_LOGIN_CONSOLE:-}" ] && command -v systemd-cat >/dev/null 2>&1 \
    && systemd-cat --identifier=tessel-login-greeter true 2>/dev/null; then
    verbose=-V
    journal="systemd-cat --identifier=tessel-login-greeter --stderr-priority=warning"
fi
set -- $journal /usr/bin/dbus-run-session -- /usr/bin/labwc $verbose --config-dir /etc/tessel/login/labwc \
    --session /usr/local/lib/tessel/tessel-login
exec "$@"
