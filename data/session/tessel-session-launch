#!/bin/sh
# The packaged Tessel session (usr/share/wayland-sessions/tessel.desktop): set up
# this user's labwc files once per installed package version, then run labwc.
# tools/install.py does this setup itself, so a ~/.local install is left alone.
libdir=/usr/lib/tessel
state="${XDG_STATE_HOME:-$HOME/.local/state}/tessel"
version=$(cat "$libdir/session-version" 2>/dev/null)
if [ ! -x "$HOME/.local/lib/tessel/tessel-configure-session" ] &&
   [ "$(cat "$state/session-version" 2>/dev/null)" != "$version" ]; then
    "$libdir/tessel-configure-session" --apply >/dev/null 2>&1 &&
        "$libdir/tessel-xdg-autostart" --apply >/dev/null 2>&1 &&
        mkdir -p "$state" && printf '%s\n' "$version" > "$state/session-version"
fi
# For a bug report: `touch ~/.config/tessel/compositor-debug` makes the
# compositor log everything it does (labwc -d) from the next login on, to the
# journal with the rest of the session (journalctl -b -t tessel-session).
# Remove the file afterwards; the log is large.
if [ -e "${XDG_CONFIG_HOME:-$HOME/.config}/tessel/compositor-debug" ]; then
    set -- -d "$@"
fi
exec /usr/bin/labwc "$@"
